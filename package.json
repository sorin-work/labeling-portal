{
  "name": "labeling-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Work portal for data-labeling teams: projects, task queues, review, quality and payouts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "node docker/server.mjs",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:dom": "vitest run --project dom",
    "db:seed": "tsx prisma/seed.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/express": "^7.18.3",
    "@react-router/node": "^7.18.3",
    "@react-router/serve": "^7.18.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "express": "^4.22.2",
    "isbot": "^5.2.0",
    "marked": "^17.0.6",
    "morgan": "^1.12.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.3",
    "tsx": "^4.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-router/dev": "^7.18.3",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
