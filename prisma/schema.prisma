generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskKind {
  TEXT_CLASSIFICATION
  IMAGE_CLASSIFICATION
  NER
  PAIRWISE
  BBOX
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ImportFormat {
  CSV
  JSONL
  JSON
  TSV
}

enum TaskStatus {
  OPEN
  /// its answers agree less than the project's threshold, after every extra annotator
  ADJUDICATION
  COMPLETE
}

enum AssignmentStatus {
  ACTIVE
  SUBMITTED
  SKIPPED
  EXPIRED
  RELEASED
}

enum ReviewStatus {
  PENDING
  APPROVED
  SENT_BACK
  FIXED
  NOT_REQUIRED
}

enum ReviewDecision {
  APPROVE
  SEND_BACK
  FIX
}

/// How sampling treated a submission in a project that reviews only a share.
enum ReviewSample {
  NEW_ANNOTATOR
  FLAGGED
  DRAWN
  NOT_DRAWN
}

/// What a manager did to a gold task.
enum GoldChange {
  CREATED
  EDITED
  RETIRED
  RESTORED
}

enum DisputeStatus {
  OPEN
  UPHELD
  OVERTURNED
  /// taken back by the annotator before anyone settled it
  WITHDRAWN
}

/// How the queue orders the tasks of a batch.
enum QueueOrder {
  IMPORT
  SHUFFLED
}

enum PayMode {
  PER_TASK
  HOURLY
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  REVIEWER
  ANNOTATOR
}

model Organization {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  createdAt   DateTime           @default(now())
  memberships Membership[]
  projects    Project[]
  credited    CreditedInterval[]
  activity    Activity[]
  apiTokens   ApiToken[]
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String
  passwordHash          String
  /// goes up to end every session: a cookie made with another number is no session
  sessionVersion        Int                    @default(0)
  createdAt             DateTime               @default(now())
  memberships           Membership[]
  projects              ProjectMember[]
  assignments           Assignment[]
  reviews               Review[]
  reviewHolds           Assignment[]           @relation("ReviewHold")
  disputesOpened        Dispute[]              @relation("DisputeOpenedBy")
  disputesResolved      Dispute[]              @relation("DisputeResolvedBy")
  goldRevisions         GoldRevision[]
  adjudications         Task[]                 @relation("Adjudication")
  qualificationAttempts QualificationAttempt[]
  activity              Activity[]
  credited              CreditedInterval[]
  apiTokens             ApiToken[]
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      Role
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// A stretch of a person's time that has been credited to some piece of
/// work in an organisation. Credits never overlap these, so no minute is paid
/// twice. Kept by organisation and user, not by membership, so removing and
/// adding someone again does not forget what was credited.
model CreditedInterval {
  id     String       @id @default(cuid())
  orgId  String
  userId String
  start  DateTime
  end    DateTime
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, end])
  @@index([userId])
}

model Project {
  id                       String                 @id @default(cuid())
  orgId                    String
  name                     String
  description              String                 @default("")
  instructions             String                 @default("")
  instructionsUpdatedAt    DateTime?
  kind                     TaskKind
  schema                   Json
  /// the rule that suggests answers at import (see domain/prelabel.ts); empty: none
  prelabel                 Json?
  status                   ProjectStatus          @default(DRAFT)
  overlap                  Int                    @default(1)
  timeLimitMinutes         Int                    @default(30)
  reviewRequired           Boolean                @default(true)
  /// share of submissions that go to a reviewer while review is on
  reviewSamplePercent      Int                    @default(100)
  /// days after a review in which the annotator may dispute it; 0 turns disputes off
  disputeWindowDays        Int                    @default(14)
  /// annotators see their score and the expected answer of a gold task once they have submitted it
  goldFeedback             Boolean                @default(true)
  /// import order, or an order of its own for every annotator
  queueOrder               QueueOrder             @default(IMPORT)
  /// about one gold task in every N; empty leaves gold where its position puts it
  goldEvery                Int?
  /// tasks one person may submit (or hold) in the project per UTC day; empty is no limit
  dailyTaskLimit           Int?
  /// a task whose agreement is under this (0 to 1) gets extra annotators, then adjudication; empty is off
  agreementThreshold       Float?
  /// how many extra annotators a task under the threshold gets before adjudication (0 to 3)
  maxExtraAnnotators       Int                    @default(1)
  qualificationRequired    Boolean                @default(false)
  qualificationPassPercent Int                    @default(80)
  payMode                  PayMode                @default(PER_TASK)
  /// cents per accepted task, or per hour of active time
  rateCents                Int                    @default(0)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  org                      Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members                  ProjectMember[]
  batches                  Batch[]
  tasks                    Task[]
  assignments              Assignment[]
  qualificationAttempts    QualificationAttempt[]
  activity                 Activity[]
  queueSecret              QueueSecret?

  @@index([orgId])
}

/// The key of the hashes that decide gold timing and the shuffled order of a
/// project. A table of its own, so that loading a project never loads it.
model QueueSecret {
  projectId String  @id
  secret    String  @default(dbgenerated("encode(gen_random_bytes(32), 'hex'::text)"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  id          String    @id @default(cuid())
  projectId   String
  userId      String
  createdAt   DateTime  @default(now())
  qualifiedAt DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Batch {
  id             String       @id @default(cuid())
  projectId      String
  name           String
  format         ImportFormat
  /// batches with a higher number are handed out first
  priority       Int          @default(0)
  /// set while nothing from this batch is handed out
  pausedAt       DateTime?
  /// the Idempotency-Key of the API upload that made it; a repeat gets this batch
  idempotencyKey String?
  /// the SHA-256 of that upload's body; the same key with another body is refused
  idempotencyHash String?
  /// the project's suggestion rule over this batch: empty, PENDING, DONE, TIMED_OUT or FAILED
  prelabelState  String?
  /// what the last run did, in one sentence for the batch page
  prelabelNote   String?
  createdAt      DateTime     @default(now())
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId])
}

/// A token for the JSON API under /api/v1. Only the SHA-256 of the token is
/// kept; the token itself is shown once, when it is made. It acts as its
/// user with the role their membership has at the time of each request.
model ApiToken {
  id         String       @id @default(cuid())
  userId     String
  orgId      String
  name       String
  tokenHash  String       @unique
  /// the first characters, to tell tokens apart in the list
  prefix     String
  readOnly   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, orgId])
}

model Task {
  id              String         @id @default(cuid())
  projectId       String
  batchId         String
  externalId      String?
  position        Int
  data            Json
  status          TaskStatus     @default(OPEN)
  /// merged answer of the accepted submissions, set when the task completes
  consensus       Json?
  agreement       Float?
  /// honeypot task with a known answer, scored automatically
  isGold          Boolean        @default(false)
  /// part of the qualification test, never handed out in the queue
  isQualification Boolean        @default(false)
  goldAnswer      Json?
  /// a suggested answer, never an annotation: from the import file (`_prediction`)
  /// or the project's rule; checked against the schema when it is stored
  suggestion      Json?
  /// where it came from: "file", or the name of the rule
  suggestionSource String?
  /// set when a manager retired this gold task: not handed out any more, its scores do not count
  goldRetiredAt   DateTime?
  /// the completed task this gold task was copied from
  goldSourceId    String?
  /// annotators added over the project's overlap because the answers agreed too little
  extraSlots      Int            @default(0)
  /// claims and submissions on the task (ACTIVE or SUBMITTED), kept by a trigger on Assignment
  takenSlots      Int            @default(0)
  /// when the task went to adjudication
  escalatedAt     DateTime?
  /// while it waits there: what a majority of the answers says, if anything; not a result
  majority        Json?
  /// who settled the task in adjudication, when and why; their answer is the consensus
  adjudicatedById String?
  adjudicatedAt   DateTime?
  adjudicatedNote String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batch           Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  goldSource      Task?          @relation("GoldCopy", fields: [goldSourceId], references: [id], onDelete: SetNull)
  goldCopies      Task[]         @relation("GoldCopy")
  adjudicatedBy   User?          @relation("Adjudication", fields: [adjudicatedById], references: [id], onDelete: SetNull)
  goldRevisions   GoldRevision[]
  assignments     Assignment[]

  @@index([projectId, status, position])
  @@index([batchId, position])
  @@index([batchId, status, position])
  @@index([batchId, status, isGold, position])
  @@index([goldSourceId])
  @@index([projectId, status, escalatedAt])
}

/// One change to a gold task: who made it, when, why, and the expected answer before and after.
model GoldRevision {
  id             String     @id @default(cuid())
  taskId         String
  change         GoldChange
  /// the expected answer before the change; empty when the task became gold with it
  previousAnswer Json?
  /// the expected answer after the change
  answer         Json?
  reason         String
  changedById    String
  createdAt      DateTime   @default(now())
  task           Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy      User       @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// One annotator's claim on a task, and later their answer.
model Assignment {
  id             String           @id @default(cuid())
  projectId      String
  taskId         String
  userId         String
  status         AssignmentStatus @default(ACTIVE)
  claimedAt      DateTime         @default(now())
  expiresAt      DateTime
  /// when the annotator last asked for more time
  extendedAt     DateTime?
  /// how often the annotator asked for more time on this claim (MAX_EXTENSIONS at most)
  extensions     Int              @default(0)
  submittedAt    DateTime?
  /// the project's rate and pay mode when the work was first submitted;
  /// payouts and earnings read these, never the project's current values
  rateCents      Int?
  payMode        PayMode?
  /// the moment the work became payable, which puts it into a pay period;
  /// set by the write that accepts the work and empty while it is not accepted
  payableAt      DateTime?
  skipReason     String?
  answer         Json?
  activeSeconds  Int              @default(0)
  /// unfinished answer saved from the work or revise page, not validated
  draft          Json?
  /// working time that came with the last draft save
  draftSeconds   Int              @default(0)
  /// the annotator started from the task's suggestion
  fromSuggestion Boolean       @default(false)
  /// with a suggestion: true when the submitted answer is the suggestion unchanged
  suggestionUnchanged Boolean?
  reviewStatus   ReviewStatus?
  reviewedAt     DateTime?
  /// decided once at submission when the project reviews a share; empty otherwise
  reviewSample   ReviewSample?
  /// the reviewer who reserved this submission; the hold lapses after 15 minutes
  reviewHeldById String?
  reviewHeldAt   DateTime?
  /// 0..1 match against the gold answer, for gold tasks only
  goldScore      Float?
  reviews        Review[]
  disputes       Dispute[]
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewHeldBy   User?            @relation("ReviewHold", fields: [reviewHeldById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([userId, status])
  @@index([taskId, status])
  @@index([projectId, reviewStatus])
  @@index([userId, submittedAt])
  @@index([projectId, submittedAt])
  @@index([userId, payableAt])
  @@index([projectId, payableAt])
}

model Review {
  id              String         @id @default(cuid())
  assignmentId    String
  reviewerId      String
  decision        ReviewDecision
  qaScore         Int?
  feedback        String         @default("")
  correctedAnswer Json?
  createdAt       DateTime       @default(now())
  /// set when a dispute overturned this decision; the row itself is kept as it was
  overturnedAt    DateTime?
  /// a reviewer looked at accepted work no reviewer had seen; it records and changes nothing
  spotCheck       Boolean        @default(false)
  dispute         Dispute?
  assignment      Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewer        User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([reviewerId, createdAt])
}

/// An annotator's objection to one review decision, and how it was settled.
model Dispute {
  id           String        @id @default(cuid())
  assignmentId String
  /// the decision under dispute; a decision can be disputed once
  reviewId     String        @unique
  openedById   String
  reason       String
  /// the annotator's answer as it stood when the dispute was opened
  answer       Json
  status       DisputeStatus @default(OPEN)
  resolvedById String?
  resolution   String?
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  assignment   Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  review       Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  openedBy     User          @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  resolvedBy   User?         @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([assignmentId])
  @@index([status])
}

model QualificationAttempt {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  scorePercent Float
  passed       Boolean
  answers      Json
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
}

/// Things managers did to a project: settings, imports, status changes, members.
/// The audit trail: what managers, reviewers and admins changed, and the
/// sign-ins and downloads of the organisation. Rows are only ever added; the
/// database refuses to change or remove one (see the migration), except that
/// the actor and project links are cleared when those are deleted.
model Activity {
  id        String       @id @default(cuid())
  orgId     String
  /// empty for what is not about one project (people, sign-ins, pay report)
  projectId String?
  /// empty once the account is deleted; `actorName` keeps who it was
  actorId   String?
  actorName String
  action    String
  detail    Json?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorId])
}
