generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskKind {
  TEXT_CLASSIFICATION
  NER
  PAIRWISE
  BBOX
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ImportFormat {
  CSV
  JSONL
}

enum TaskStatus {
  OPEN
  COMPLETE
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  REVIEWER
  ANNOTATOR
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  projects    Project[]
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  memberships  Membership[]
  projects     ProjectMember[]
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      Role
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Project {
  id               String          @id @default(cuid())
  orgId            String
  name             String
  description      String          @default("")
  instructions     String          @default("")
  kind             TaskKind
  schema           Json
  status           ProjectStatus   @default(DRAFT)
  overlap          Int             @default(1)
  timeLimitMinutes Int             @default(30)
  reviewRequired   Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  batches          Batch[]
  tasks            Task[]

  @@index([orgId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Batch {
  id        String       @id @default(cuid())
  projectId String
  name      String
  format    ImportFormat
  createdAt DateTime     @default(now())
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  batchId     String
  externalId  String?
  position    Int
  data        Json
  status      TaskStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batch       Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([projectId, status, position])
  @@index([batchId, position])
}
