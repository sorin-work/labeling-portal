generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskKind {
  TEXT_CLASSIFICATION
  NER
  PAIRWISE
  BBOX
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ImportFormat {
  CSV
  JSONL
}

enum TaskStatus {
  OPEN
  COMPLETE
}

enum AssignmentStatus {
  ACTIVE
  SUBMITTED
  SKIPPED
  EXPIRED
  RELEASED
}

enum ReviewStatus {
  PENDING
  APPROVED
  SENT_BACK
  FIXED
  NOT_REQUIRED
}

enum ReviewDecision {
  APPROVE
  SEND_BACK
  FIX
}

/// How sampling treated a submission in a project that reviews only a share.
enum ReviewSample {
  NEW_ANNOTATOR
  FLAGGED
  DRAWN
  NOT_DRAWN
}

/// What a manager did to a gold task.
enum GoldChange {
  CREATED
  EDITED
  RETIRED
  RESTORED
}

enum DisputeStatus {
  OPEN
  UPHELD
  OVERTURNED
  /// taken back by the annotator before anyone settled it
  WITHDRAWN
}

/// How the queue orders the tasks of a batch.
enum QueueOrder {
  IMPORT
  SHUFFLED
}

enum PayMode {
  PER_TASK
  HOURLY
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  REVIEWER
  ANNOTATOR
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  projects    Project[]
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String
  passwordHash          String
  createdAt             DateTime               @default(now())
  memberships           Membership[]
  projects              ProjectMember[]
  assignments           Assignment[]
  reviews               Review[]
  reviewHolds           Assignment[]           @relation("ReviewHold")
  disputesOpened        Dispute[]              @relation("DisputeOpenedBy")
  disputesResolved      Dispute[]              @relation("DisputeResolvedBy")
  goldRevisions         GoldRevision[]
  qualificationAttempts QualificationAttempt[]
  activity              Activity[]
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      Role
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Project {
  id                       String                 @id @default(cuid())
  orgId                    String
  name                     String
  description              String                 @default("")
  instructions             String                 @default("")
  instructionsUpdatedAt    DateTime?
  kind                     TaskKind
  schema                   Json
  status                   ProjectStatus          @default(DRAFT)
  overlap                  Int                    @default(1)
  timeLimitMinutes         Int                    @default(30)
  reviewRequired           Boolean                @default(true)
  /// share of submissions that go to a reviewer while review is on
  reviewSamplePercent      Int                    @default(100)
  /// days after a review in which the annotator may dispute it; 0 turns disputes off
  disputeWindowDays        Int                    @default(14)
  /// annotators see their score and the expected answer of a gold task once they have submitted it
  goldFeedback             Boolean                @default(true)
  /// import order, or an order of its own for every annotator
  queueOrder               QueueOrder             @default(IMPORT)
  /// about one gold task in every N; empty leaves gold where its position puts it
  goldEvery                Int?
  qualificationRequired    Boolean                @default(false)
  qualificationPassPercent Int                    @default(80)
  payMode                  PayMode                @default(PER_TASK)
  /// cents per accepted task, or per hour of active time
  rateCents                Int                    @default(0)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  org                      Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members                  ProjectMember[]
  batches                  Batch[]
  tasks                    Task[]
  assignments              Assignment[]
  qualificationAttempts    QualificationAttempt[]
  activity                 Activity[]
  queueSecret              QueueSecret?

  @@index([orgId])
}

/// The key of the hashes that decide gold timing and the shuffled order of a
/// project. A table of its own, so that loading a project never loads it.
model QueueSecret {
  projectId String  @id
  secret    String  @default(dbgenerated("encode(gen_random_bytes(32), 'hex'::text)"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  id          String    @id @default(cuid())
  projectId   String
  userId      String
  createdAt   DateTime  @default(now())
  qualifiedAt DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Batch {
  id        String       @id @default(cuid())
  projectId String
  name      String
  format    ImportFormat
  /// batches with a higher number are handed out first
  priority  Int          @default(0)
  /// set while nothing from this batch is handed out
  pausedAt  DateTime?
  createdAt DateTime     @default(now())
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

model Task {
  id              String       @id @default(cuid())
  projectId       String
  batchId         String
  externalId      String?
  position        Int
  data            Json
  status          TaskStatus   @default(OPEN)
  /// merged answer of the accepted submissions, set when the task completes
  consensus       Json?
  agreement       Float?
  /// honeypot task with a known answer, scored automatically
  isGold          Boolean      @default(false)
  /// part of the qualification test, never handed out in the queue
  isQualification Boolean      @default(false)
  goldAnswer      Json?
  /// set when a manager retired this gold task: not handed out any more, its scores do not count
  goldRetiredAt   DateTime?
  /// the completed task this gold task was copied from
  goldSourceId    String?
  createdAt       DateTime     @default(now())
  completedAt     DateTime?
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batch           Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  goldSource      Task?        @relation("GoldCopy", fields: [goldSourceId], references: [id], onDelete: SetNull)
  goldCopies      Task[]       @relation("GoldCopy")
  goldRevisions   GoldRevision[]
  assignments     Assignment[]

  @@index([projectId, status, position])
  @@index([batchId, position])
  @@index([batchId, status, position])
  @@index([batchId, status, isGold, position])
  @@index([goldSourceId])
}

/// One change to a gold task: who made it, when, why, and the expected answer before and after.
model GoldRevision {
  id             String     @id @default(cuid())
  taskId         String
  change         GoldChange
  /// the expected answer before the change; empty when the task became gold with it
  previousAnswer Json?
  /// the expected answer after the change
  answer         Json?
  reason         String
  changedById    String
  createdAt      DateTime   @default(now())
  task           Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy      User       @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// One annotator's claim on a task, and later their answer.
model Assignment {
  id            String           @id @default(cuid())
  projectId     String
  taskId        String
  userId        String
  status        AssignmentStatus @default(ACTIVE)
  claimedAt     DateTime         @default(now())
  expiresAt     DateTime
  /// set when the annotator asked for more time (allowed once per claim)
  extendedAt    DateTime?
  submittedAt   DateTime?
  skipReason    String?
  answer        Json?
  activeSeconds Int              @default(0)
  /// unfinished answer saved from the work or revise page, not validated
  draft         Json?
  /// working time that came with the last draft save
  draftSeconds  Int              @default(0)
  reviewStatus  ReviewStatus?
  reviewedAt    DateTime?
  /// decided once at submission when the project reviews a share; empty otherwise
  reviewSample  ReviewSample?
  /// the reviewer who reserved this submission; the hold lapses after 15 minutes
  reviewHeldById String?
  reviewHeldAt  DateTime?
  /// 0..1 match against the gold answer, for gold tasks only
  goldScore     Float?
  reviews       Review[]
  disputes      Dispute[]
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewHeldBy  User?            @relation("ReviewHold", fields: [reviewHeldById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([userId, status])
  @@index([taskId, status])
  @@index([projectId, reviewStatus])
  @@index([userId, submittedAt])
  @@index([projectId, submittedAt])
}

model Review {
  id              String         @id @default(cuid())
  assignmentId    String
  reviewerId      String
  decision        ReviewDecision
  qaScore         Int?
  feedback        String         @default("")
  correctedAnswer Json?
  createdAt       DateTime       @default(now())
  /// set when a dispute overturned this decision; the row itself is kept as it was
  overturnedAt    DateTime?
  dispute         Dispute?
  assignment      Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewer        User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([reviewerId, createdAt])
}

/// An annotator's objection to one review decision, and how it was settled.
model Dispute {
  id           String        @id @default(cuid())
  assignmentId String
  /// the decision under dispute; a decision can be disputed once
  reviewId     String        @unique
  openedById   String
  reason       String
  /// the annotator's answer as it stood when the dispute was opened
  answer       Json
  status       DisputeStatus @default(OPEN)
  resolvedById String?
  resolution   String?
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  assignment   Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  review       Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  openedBy     User          @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  resolvedBy   User?         @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([assignmentId])
  @@index([status])
}

model QualificationAttempt {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  scorePercent Float
  passed       Boolean
  answers      Json
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
}

/// Things managers did to a project: settings, imports, status changes, members.
model Activity {
  id        String   @id @default(cuid())
  projectId String
  actorId   String
  action    String
  detail    Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
