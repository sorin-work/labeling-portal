generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskKind {
  TEXT_CLASSIFICATION
  NER
  PAIRWISE
  BBOX
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ImportFormat {
  CSV
  JSONL
}

enum TaskStatus {
  OPEN
  COMPLETE
}

enum AssignmentStatus {
  ACTIVE
  SUBMITTED
  SKIPPED
  EXPIRED
  RELEASED
}

enum ReviewStatus {
  PENDING
  APPROVED
  SENT_BACK
  FIXED
  NOT_REQUIRED
}

enum ReviewDecision {
  APPROVE
  SEND_BACK
  FIX
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  REVIEWER
  ANNOTATOR
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  projects    Project[]
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  memberships  Membership[]
  projects     ProjectMember[]
  assignments  Assignment[]
  reviews      Review[]
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      Role
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Project {
  id               String          @id @default(cuid())
  orgId            String
  name             String
  description      String          @default("")
  instructions     String          @default("")
  kind             TaskKind
  schema           Json
  status           ProjectStatus   @default(DRAFT)
  overlap          Int             @default(1)
  timeLimitMinutes Int             @default(30)
  reviewRequired   Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  batches          Batch[]
  tasks            Task[]
  assignments      Assignment[]

  @@index([orgId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Batch {
  id        String       @id @default(cuid())
  projectId String
  name      String
  format    ImportFormat
  createdAt DateTime     @default(now())
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  batchId     String
  externalId  String?
  position    Int
  data        Json
  status      TaskStatus   @default(OPEN)
  /// merged answer of the accepted submissions, set when the task completes
  consensus   Json?
  agreement   Float?
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([projectId, status, position])
  @@index([batchId, position])
}

/// One annotator's claim on a task, and later their answer.
model Assignment {
  id            String           @id @default(cuid())
  projectId     String
  taskId        String
  userId        String
  status        AssignmentStatus @default(ACTIVE)
  claimedAt     DateTime         @default(now())
  expiresAt     DateTime
  submittedAt   DateTime?
  skipReason    String?
  answer        Json?
  activeSeconds Int              @default(0)
  reviewStatus  ReviewStatus?
  reviewedAt    DateTime?
  reviews       Review[]
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([userId, status])
  @@index([taskId, status])
  @@index([projectId, reviewStatus])
}

model Review {
  id              String         @id @default(cuid())
  assignmentId    String
  reviewerId      String
  decision        ReviewDecision
  qaScore         Int?
  feedback        String         @default("")
  correctedAnswer Json?
  createdAt       DateTime       @default(now())
  assignment      Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewer        User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([reviewerId, createdAt])
}
