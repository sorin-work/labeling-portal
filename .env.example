DATABASE_URL=postgresql://labeling:labeling@localhost:5432/labeling
SESSION_SECRET=change-me-to-a-long-random-string
# Integration tests use a separate database
TEST_DATABASE_URL=postgresql://labeling:labeling@localhost:5432/labeling_test
# Set to true to list the demo accounts on the sign-in page
SHOW_DEMO_LOGINS=false
# Secure cookies default to on in production; set false when serving over plain http
COOKIE_SECURE=
